# Kibana Dev Tools — 03-search
# 依赖：先跑 python demos/01-crud/main.py 写入 products

############################################################
# match：全文（会对 text 分词）
############################################################
GET /products/_search
{
  "query": {
    "match": { "description": "办公" }
  }
}

############################################################
# term：精确值（用 keyword 字段）
############################################################
GET /products/_search
{
  "query": {
    "term": { "brand": "KeyChron" }
  }
}

############################################################
# range：数值范围
############################################################
GET /products/_search
{
  "query": {
    "range": {
      "price": { "gte": 200, "lte": 800 }
    }
  }
}

############################################################
# bool：组合 must / filter / must_not
############################################################
GET /products/_search
{
  "query": {
    "bool": {
      "must": [
        { "match": { "description": "办公" } }
      ],
      "filter": [
        { "term": { "in_stock": true } },
        { "range": { "price": { "lte": 1000 } } }
      ],
      "must_not": [
        { "term": { "category": "家具" } }
      ]
    }
  }
}
