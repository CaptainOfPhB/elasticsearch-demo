# Kibana Dev Tools — 06-agg
# 依赖：python demos/01-crud/main.py

############################################################
# terms：按品牌计数
############################################################
GET /products/_search
{
  "size": 0,
  "aggs": {
    "by_brand": {
      "terms": { "field": "brand", "size": 10 }
    }
  }
}

############################################################
# metric：均价 / 销量合计
############################################################
GET /products/_search
{
  "size": 0,
  "aggs": {
    "avg_price": { "avg": { "field": "price" } },
    "sum_sold": { "sum": { "field": "sold" } }
  }
}

############################################################
# bucket + metric：分类下的均价
############################################################
GET /products/_search
{
  "size": 0,
  "aggs": {
    "by_category": {
      "terms": { "field": "category" },
      "aggs": {
        "avg_price": { "avg": { "field": "price" } }
      }
    }
  }
}
